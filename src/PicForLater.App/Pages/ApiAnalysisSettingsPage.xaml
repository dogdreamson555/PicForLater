<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PicForLater.App.Pages.ApiAnalysisSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PicForLater.App.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="768"
    d:DesignWidth="1024"
    mc:Ignorable="d">

    <ScrollViewer
        AutomationProperties.AutomationId="ApiAnalysisSettingsPage"
        Background="{ThemeResource AppPageBackgroundBrush}"
        HorizontalContentAlignment="Stretch"
        HorizontalScrollMode="Disabled"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <Grid x:Name="PageRoot">
            <StackPanel
                x:Name="ContentPanel"
                MaxWidth="{StaticResource AppSinglePaneDetailMaxWidth}"
                Margin="{StaticResource AppPagePaddingNarrow}"
                HorizontalAlignment="Stretch"
                Spacing="{StaticResource AppSpacingLg}">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="WidthStates">
                        <VisualState x:Name="Narrow">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="0" />
                            </VisualState.StateTriggers>
                        </VisualState>
                        <VisualState x:Name="Medium">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="{StaticResource AppBreakpointMedium}" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="ContentPanel.Margin" Value="{StaticResource AppPagePaddingMedium}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Wide">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="{StaticResource AppBreakpointExpanded}" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="ContentPanel.Margin" Value="{StaticResource AppPagePaddingWide}" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>

                <Grid x:Name="PageHeader">
                    <Button
                        x:Name="SettingsBackButton"
                        x:Uid="SettingsBackButton"
                        Style="{StaticResource AppBackButtonStyle}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        AutomationProperties.AutomationId="SettingsBackButton"
                        Click="SettingsBackButton_Click">
                        <FontIcon
                            AutomationProperties.AccessibilityView="Raw"
                            FontSize="20"
                            Glyph="{StaticResource AppBackIconGlyph}" />
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Left" Modifiers="Menu" />
                        </Button.KeyboardAccelerators>
                    </Button>
                    <StackPanel
                        x:Name="PageHeaderContent"
                        Margin="52,0,0,0"
                        Spacing="{StaticResource AppSpacingXs}">
                        <TextBlock x:Uid="ApiAnalysisSettingsPageTitle" Style="{StaticResource AppPageTitleTextBlockStyle}" />
                        <TextBlock x:Uid="ApiAnalysisSettingsPageSubtitle" Style="{StaticResource AppPageSubtitleTextBlockStyle}" />
                    </StackPanel>
                </Grid>

                <InfoBar
                    x:Uid="ApiConnectionStatusInfoBar"
                    AutomationProperties.AutomationId="ApiConnectionStatusInfoBar"
                    AutomationProperties.HelpText="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    AutomationProperties.LiveSetting="Polite"
                    IsClosable="True"
                    IsOpen="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}"
                    Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    Severity="{x:Bind local:ApiAnalysisSettingsPage.StatusSeverity(ViewModel.StatusKind), Mode=OneWay}"
                    Visibility="{x:Bind local:ApiAnalysisSettingsPage.ElementVisibility(ViewModel.HasStatusMessage), Mode=OneWay}" />

                <StackPanel Spacing="{StaticResource AppSpacingXl}">
                    <StackPanel Spacing="{StaticResource AppSpacingSm}">
                        <StackPanel Spacing="{StaticResource AppSpacingXs}">
                            <TextBlock x:Uid="ApiProviderSectionTitle" Style="{StaticResource AppSectionTitleTextBlockStyle}" />
                            <TextBlock
                                x:Uid="ApiProviderSectionDescription"
                                Foreground="{ThemeResource AppSecondaryTextBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Style="{StaticResource AppSettingsListGroupStyle}">
                            <StackPanel>
                                <Grid
                                    x:Name="ApiCategoryRow"
                                    MinHeight="60"
                                    Padding="12,14"
                                    ColumnSpacing="{StaticResource AppSpacingLg}"
                                    RowSpacing="{StaticResource AppSpacingSm}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition x:Name="ApiCategoryControlColumn" Width="400" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        x:Uid="ApiCategoryRowTitle"
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold" />
                                    <ComboBox
                                        x:Name="ApiCategoryComboBox"
                                        x:Uid="ApiCategoryComboBox"
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center"
                                        AutomationProperties.AutomationId="ApiCategoryComboBox"
                                        DisplayMemberPath="DisplayName"
                                        IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                        ItemsSource="{x:Bind ViewModel.CategoryOptions, Mode=OneWay}"
                                        SelectedItem="{x:Bind ViewModel.SelectedCategoryOption, Mode=TwoWay}"
                                        SelectionChanged="ApiCategoryComboBox_SelectionChanged" />
                                </Grid>
                                <Border Height="1" Background="{ThemeResource AppDividerBrush}" />
                                <Grid
                                    x:Name="ApiProviderRow"
                                    MinHeight="60"
                                    Padding="12,14"
                                    ColumnSpacing="{StaticResource AppSpacingLg}"
                                    RowSpacing="{StaticResource AppSpacingSm}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition x:Name="ApiProviderControlColumn" Width="400" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        x:Uid="ApiProviderRowTitle"
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold" />
                                    <ComboBox
                                        x:Name="ApiProviderComboBox"
                                        x:Uid="ApiProviderComboBox"
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center"
                                        AutomationProperties.AutomationId="ApiProviderComboBox"
                                        DisplayMemberPath="DisplayName"
                                        IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                        ItemsSource="{x:Bind ViewModel.ProviderOptions, Mode=OneWay}"
                                        SelectedItem="{x:Bind ViewModel.SelectedProviderOption, Mode=OneWay}"
                                        SelectionChanged="ApiProviderComboBox_SelectionChanged" />
                                </Grid>
                                <Border Height="1" Background="{ThemeResource AppDividerBrush}" />
                                <Grid
                                    x:Name="ApiModelRow"
                                    MinHeight="60"
                                    Padding="12,14"
                                    ColumnSpacing="{StaticResource AppSpacingLg}"
                                    RowSpacing="{StaticResource AppSpacingSm}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition x:Name="ApiModelControlColumn" Width="400" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        x:Uid="ApiModelRowTitle"
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold" />
                                    <TextBox
                                        x:Name="ApiModelIdTextBox"
                                        x:Uid="ApiModelIdTextBox"
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center"
                                        AutomationProperties.AutomationId="ApiModelIdTextBox"
                                        IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                        MaxLength="200"
                                        Text="{x:Bind ViewModel.ModelId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="{StaticResource AppSpacingSm}">
                        <StackPanel Spacing="{StaticResource AppSpacingXs}">
                            <TextBlock x:Uid="ApiCredentialSectionTitle" Style="{StaticResource AppSectionTitleTextBlockStyle}" />
                            <TextBlock
                                x:Uid="ApiCredentialSectionDescription"
                                Foreground="{ThemeResource AppSecondaryTextBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Style="{StaticResource AppSettingsListGroupStyle}">
                            <StackPanel>
                                <Grid
                                    MinHeight="60"
                                    Padding="12,14"
                                    ColumnSpacing="{StaticResource AppSpacingMd}"
                                    Visibility="{x:Bind local:ApiAnalysisSettingsPage.CredentialInputVisibility(ViewModel.RequiresCredential, ViewModel.HasCredential), Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox
                                        x:Name="ApiCredentialPasswordBox"
                                        x:Uid="ApiCredentialPasswordBox"
                                        VerticalAlignment="Center"
                                        AutomationProperties.AutomationId="ApiCredentialPasswordBox"
                                        IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                        MaxLength="8192"
                                        PasswordRevealMode="Peek" />
                                    <Button
                                        x:Uid="SaveApiCredentialButton"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        AutomationProperties.AutomationId="SaveApiCredentialButton"
                                        Click="SaveApiCredentialButton_Click"
                                        IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" />
                                </Grid>
                                <Grid
                                    MinHeight="60"
                                    Padding="12,14"
                                    ColumnSpacing="{StaticResource AppSpacingMd}"
                                    Visibility="{x:Bind local:ApiAnalysisSettingsPage.CredentialSavedVisibility(ViewModel.RequiresCredential, ViewModel.HasCredential), Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        AutomationProperties.AutomationId="ApiCredentialSavedStatusText"
                                        Foreground="{ThemeResource AppSecondaryTextBrush}"
                                        Text="{x:Bind ViewModel.CredentialStatusText, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                    <Button
                                        x:Uid="DeleteApiCredentialButton"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        AutomationProperties.AutomationId="DeleteApiCredentialButton"
                                        Click="DeleteApiCredentialButton_Click"
                                        IsEnabled="{x:Bind ViewModel.CanDeleteCredential, Mode=OneWay}" />
                                </Grid>
                                <Border
                                    MinHeight="60"
                                    Padding="12,14"
                                    Visibility="{x:Bind local:ApiAnalysisSettingsPage.NoCredentialVisibility(ViewModel.RequiresCredential), Mode=OneWay}">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        AutomationProperties.AutomationId="ApiCredentialNotRequiredStatusText"
                                        Foreground="{ThemeResource AppSecondaryTextBrush}"
                                        Text="{x:Bind ViewModel.CredentialStatusText, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="{StaticResource AppSpacingSm}">
                        <StackPanel Spacing="{StaticResource AppSpacingXs}">
                            <TextBlock x:Uid="ApiInputModeSectionTitle" Style="{StaticResource AppSectionTitleTextBlockStyle}" />
                            <TextBlock
                                x:Uid="ApiInputModeSectionDescription"
                                Foreground="{ThemeResource AppSecondaryTextBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Border
                            Padding="0,0,0,4"
                            Style="{StaticResource AppSettingsListGroupStyle}">
                            <StackPanel>
                                <RadioButtons
                                    x:Name="ApiInputModeOptions"
                                    x:Uid="ApiInputModeOptionsCompact"
                                    HorizontalAlignment="Stretch"
                                    Margin="12,0"
                                    Padding="0,6,0,12"
                                    AutomationProperties.AutomationId="ApiInputModeOptions"
                                    IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                    MaxColumns="1"
                                    SelectedIndex="{x:Bind ViewModel.SelectedInputModeIndex, Mode=TwoWay}">
                                    <RadioButton
                                        x:Uid="RemoteOcrTextOption"
                                        MinHeight="36"
                                        AutomationProperties.AutomationId="RemoteOcrTextOption" />
                                    <RadioButton
                                        x:Uid="RemoteVisionOption"
                                        MinHeight="36"
                                        AutomationProperties.AutomationId="RemoteVisionOption"
                                        IsEnabled="{x:Bind ViewModel.CanUseDirectImage, Mode=OneWay}" />
                                </RadioButtons>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="{StaticResource AppSpacingSm}">
                        <StackPanel Spacing="{StaticResource AppSpacingXs}">
                            <TextBlock
                                x:Uid="ApiOutputLanguageSectionTitle"
                                Style="{StaticResource AppSectionTitleTextBlockStyle}" />
                            <TextBlock
                                x:Uid="ApiOutputLanguageSectionDescription"
                                Foreground="{ThemeResource AppSecondaryTextBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Style="{StaticResource AppSettingsListGroupStyle}">
                            <Grid
                                x:Name="ApiOutputLanguageRow"
                                MinHeight="60"
                                Padding="12,14"
                                ColumnSpacing="{StaticResource AppSpacingLg}"
                                RowSpacing="{StaticResource AppSpacingSm}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition x:Name="ApiOutputLanguageControlColumn" Width="400" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    x:Uid="ApiOutputLanguageRowTitle"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold" />
                                <ComboBox
                                    x:Name="ApiOutputLanguageComboBox"
                                    x:Uid="ApiOutputLanguageComboBox"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="ApiOutputLanguageComboBox"
                                    IsEnabled="{x:Bind ViewModel.CanChangeOutputLanguage, Mode=OneWay}"
                                    SelectedIndex="{x:Bind ViewModel.SelectedOutputLanguageIndex, Mode=OneWay}"
                                    SelectionChanged="ApiOutputLanguageComboBox_SelectionChanged">
                                    <ComboBoxItem x:Uid="ApiOutputLanguageModelDefault" />
                                    <ComboBoxItem x:Uid="ApiOutputLanguageSimplifiedChinese" />
                                    <ComboBoxItem x:Uid="ApiOutputLanguageTraditionalChineseTaiwan" />
                                    <ComboBoxItem x:Uid="ApiOutputLanguageEnglish" />
                                </ComboBox>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="{StaticResource AppSpacingSm}">
                        <StackPanel Spacing="{StaticResource AppSpacingXs}">
                            <TextBlock x:Uid="ApiActivationSectionTitle" Style="{StaticResource AppSectionTitleTextBlockStyle}" />
                            <TextBlock
                                x:Uid="ApiActivationSectionDescription"
                                Foreground="{ThemeResource AppSecondaryTextBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Style="{StaticResource AppSettingsListGroupStyle}">
                            <StackPanel>
                            <Grid
                                MinHeight="64"
                                Padding="12,10"
                                ColumnSpacing="{StaticResource AppSpacingMd}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="{StaticResource AppSpacingXs}">
                                    <TextBlock x:Uid="ApiConnectionSectionTitle" FontWeight="SemiBold" />
                                    <TextBlock
                                        AutomationProperties.AutomationId="ApiValidationStatusText"
                                        Foreground="{ThemeResource AppSecondaryTextBrush}"
                                        Text="{x:Bind ViewModel.ValidationStatusText, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <Button
                                    x:Uid="TestApiConnectionButton"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="TestApiConnectionButton"
                                    Click="TestApiConnectionButton_Click"
                                    IsEnabled="{x:Bind ViewModel.CanTestConnection, Mode=OneWay}" />
                            </Grid>
                            <Border Height="1" Background="{ThemeResource AppDividerBrush}" />
                            <Grid
                                MinHeight="64"
                                Padding="12,10"
                                ColumnSpacing="{StaticResource AppSpacingMd}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="{StaticResource AppSpacingXs}">
                                    <TextBlock x:Uid="ApiConsentSectionTitle" FontWeight="SemiBold" />
                                    <TextBlock
                                        AutomationProperties.AutomationId="ApiConsentStatusText"
                                        Foreground="{ThemeResource AppSecondaryTextBrush}"
                                        Text="{x:Bind ViewModel.ConsentStatusText, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <Button
                                    x:Uid="EnableRemoteApiButton"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="EnableRemoteApiButton"
                                    Click="EnableRemoteApiButton_Click"
                                    IsEnabled="{x:Bind ViewModel.CanEnableRemote, Mode=OneWay}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Visibility="{x:Bind local:ApiAnalysisSettingsPage.InverseElementVisibility(ViewModel.IsCurrentProfileSelected), Mode=OneWay}" />
                                <Button
                                    x:Uid="RevokeApiConsentButton"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="RevokeApiConsentButton"
                                    Click="RevokeApiConsentButton_Click"
                                    IsEnabled="{x:Bind ViewModel.CanRevokeConsent, Mode=OneWay}"
                                    Visibility="{x:Bind local:ApiAnalysisSettingsPage.ElementVisibility(ViewModel.IsCurrentProfileSelected), Mode=OneWay}" />
                            </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="{StaticResource AppSpacingSm}">
                    <StackPanel Spacing="{StaticResource AppSpacingXs}">
                        <TextBlock x:Uid="ApiAdvancedSectionTitle" Style="{StaticResource AppSectionTitleTextBlockStyle}" />
                        <TextBlock
                            x:Uid="ApiAdvancedSectionDescription"
                            Foreground="{ThemeResource AppSecondaryTextBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Style="{StaticResource AppSettingsListGroupStyle}">
                        <StackPanel>
                            <Grid
                                x:Name="ApiEndpointRow"
                                MinHeight="60"
                                Padding="12,14"
                                ColumnSpacing="{StaticResource AppSpacingLg}"
                                RowSpacing="{StaticResource AppSpacingSm}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition x:Name="ApiEndpointControlColumn" Width="400" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="{StaticResource AppSpacingXs}">
                                    <TextBlock x:Uid="ApiEndpointRowTitle" FontWeight="SemiBold" />
                                    <TextBlock
                                        x:Uid="ApiEndpointEditDescription"
                                        Foreground="{ThemeResource AppSecondaryTextBrush}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBox
                                    x:Name="ApiEndpointTextBox"
                                    x:Uid="ApiEndpointTextBox"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="ApiEndpointTextBox"
                                    IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                    MaxLength="2048"
                                    Text="{x:Bind ViewModel.EndpointUriText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <Border Height="1" Background="{ThemeResource AppDividerBrush}" />

                            <Grid
                                x:Name="ApiReasoningRow"
                                MinHeight="60"
                                Padding="12,14"
                                ColumnSpacing="{StaticResource AppSpacingLg}"
                                RowSpacing="{StaticResource AppSpacingSm}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition x:Name="ApiReasoningControlColumn" Width="400" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    x:Uid="ApiReasoningRowTitle"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold" />
                                <ComboBox
                                    x:Name="ApiReasoningModeComboBox"
                                    x:Uid="ApiReasoningModeComboBox"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="ApiReasoningModeComboBox"
                                    DisplayMemberPath="DisplayName"
                                    ItemsSource="{x:Bind ViewModel.ReasoningOptions, Mode=OneWay}"
                                    SelectedItem="{x:Bind ViewModel.SelectedReasoningOption, Mode=TwoWay}" />
                            </Grid>

                            <Border Height="1" Background="{ThemeResource AppDividerBrush}" />

                            <Grid
                                x:Name="ApiMaxOutputTokensRow"
                                MinHeight="60"
                                Padding="12,14"
                                ColumnSpacing="{StaticResource AppSpacingLg}"
                                RowSpacing="{StaticResource AppSpacingSm}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition x:Name="ApiMaxOutputTokensControlColumn" Width="400" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    x:Uid="ApiMaxOutputTokensRowTitle"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold" />
                                <NumberBox
                                    x:Name="ApiMaxOutputTokensNumberBox"
                                    x:Uid="ApiMaxOutputTokensNumberBox"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="ApiMaxOutputTokensNumberBox"
                                    Maximum="32768"
                                    Minimum="128"
                                    SmallChange="128"
                                    SpinButtonPlacementMode="Compact"
                                    ValidationMode="InvalidInputOverwritten"
                                    Value="{x:Bind ViewModel.AdvancedMaxOutputTokens, Mode=TwoWay}" />
                            </Grid>

                            <Border Height="1" Background="{ThemeResource AppDividerBrush}" />

                            <Grid
                                x:Name="ApiTimeoutRow"
                                MinHeight="60"
                                Padding="12,14"
                                ColumnSpacing="{StaticResource AppSpacingLg}"
                                RowSpacing="{StaticResource AppSpacingSm}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition x:Name="ApiTimeoutControlColumn" Width="400" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    x:Uid="ApiTimeoutRowTitle"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold" />
                                <NumberBox
                                    x:Name="ApiTimeoutSecondsNumberBox"
                                    x:Uid="ApiTimeoutSecondsNumberBox"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="ApiTimeoutSecondsNumberBox"
                                    Maximum="600"
                                    Minimum="5"
                                    SmallChange="5"
                                    SpinButtonPlacementMode="Compact"
                                    ValidationMode="InvalidInputOverwritten"
                                    Value="{x:Bind ViewModel.AdvancedTimeoutSeconds, Mode=TwoWay}" />
                            </Grid>

                            <StackPanel
                                x:Name="ApiCustomContractSection"
                                Visibility="{x:Bind local:ApiAnalysisSettingsPage.ElementVisibility(ViewModel.IsCustomProfile), Mode=OneWay}">
                                <Border Height="1" Background="{ThemeResource AppDividerBrush}" />
                                <StackPanel Padding="12" Spacing="{StaticResource AppSpacingMd}">
                                    <StackPanel Spacing="{StaticResource AppSpacingXs}">
                                        <TextBlock x:Uid="ApiCustomContractSectionTitle" FontWeight="SemiBold" />
                                        <TextBlock
                                            x:Uid="ApiCustomContractSectionDescription"
                                            Foreground="{ThemeResource AppSecondaryTextBrush}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Grid x:Name="ApiCustomContractGrid" ColumnSpacing="{StaticResource AppSpacingMd}" RowSpacing="{StaticResource AppSpacingMd}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition x:Name="ApiCustomSecondaryColumn" Width="0" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <ComboBox
                                            x:Name="ApiCustomProtocolComboBox"
                                            x:Uid="ApiCustomProtocolComboBox"
                                            AutomationProperties.AutomationId="ApiCustomProtocolComboBox"
                                            SelectedIndex="{x:Bind ViewModel.SelectedProtocolIndex, Mode=TwoWay}">
                                            <ComboBoxItem x:Uid="ApiProtocolOpenAi" />
                                            <ComboBoxItem x:Uid="ApiProtocolAnthropic" />
                                        </ComboBox>
                                        <ComboBox
                                            x:Name="ApiCustomAuthenticationComboBox"
                                            x:Uid="ApiCustomAuthenticationComboBox"
                                            Grid.Row="1"
                                            AutomationProperties.AutomationId="ApiCustomAuthenticationComboBox"
                                            SelectedIndex="{x:Bind ViewModel.SelectedAuthenticationIndex, Mode=TwoWay}">
                                            <ComboBoxItem x:Uid="ApiAuthenticationBearer" />
                                            <ComboBoxItem x:Uid="ApiAuthenticationXApiKey" />
                                            <ComboBoxItem x:Uid="ApiAuthenticationNone" />
                                        </ComboBox>
                                        <ComboBox
                                            x:Name="ApiCustomStructuredOutputComboBox"
                                            x:Uid="ApiCustomStructuredOutputComboBox"
                                            Grid.Row="2"
                                            AutomationProperties.AutomationId="ApiCustomStructuredOutputComboBox"
                                            SelectedIndex="{x:Bind ViewModel.SelectedStructuredOutputIndex, Mode=TwoWay}">
                                            <ComboBoxItem x:Uid="ApiStructuredOutputJsonSchema" />
                                            <ComboBoxItem x:Uid="ApiStructuredOutputJsonObject" />
                                            <ComboBoxItem x:Uid="ApiStructuredOutputPromptOnly" />
                                        </ComboBox>
                                        <ComboBox
                                            x:Name="ApiCustomEndpointTrustComboBox"
                                            x:Uid="ApiCustomEndpointTrustComboBox"
                                            Grid.Row="3"
                                            AutomationProperties.AutomationId="ApiCustomEndpointTrustComboBox"
                                            SelectedIndex="{x:Bind ViewModel.SelectedEndpointTrustIndex, Mode=TwoWay}">
                                            <ComboBoxItem x:Uid="ApiEndpointTrustPublicHttps" />
                                            <ComboBoxItem x:Uid="ApiEndpointTrustLoopback" />
                                        </ComboBox>
                                        <ComboBox
                                            x:Name="ApiReasoningWireFormatComboBox"
                                            x:Uid="ApiReasoningWireFormatComboBox"
                                            Grid.Row="4"
                                            AutomationProperties.AutomationId="ApiReasoningWireFormatComboBox"
                                            SelectedIndex="{x:Bind ViewModel.SelectedReasoningWireFormatIndex, Mode=TwoWay}">
                                            <ComboBoxItem x:Uid="ApiReasoningWireNone" />
                                            <ComboBoxItem x:Uid="ApiReasoningWireThinkingObject" />
                                            <ComboBoxItem x:Uid="ApiReasoningWireEffort" />
                                            <ComboBoxItem x:Uid="ApiReasoningWireEnableThinking" />
                                            <ComboBoxItem x:Uid="ApiReasoningWireEnabledObject" />
                                        </ComboBox>
                                    </Grid>
                                    <InfoBar
                                        x:Uid="ApiCustomEndpointSafetyInfoBar"
                                        AutomationProperties.AutomationId="ApiCustomEndpointSafetyInfoBar"
                                        IsClosable="False"
                                        IsOpen="True"
                                        Severity="Warning" />
                                </StackPanel>
                            </StackPanel>

                            <Border Height="1" Background="{ThemeResource AppDividerBrush}" />
                            <Grid
                                MinHeight="60"
                                Padding="12,14"
                                ColumnSpacing="{StaticResource AppSpacingMd}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Uid="ApiAdvancedSettingsDescription"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource AppSecondaryTextBrush}"
                                    TextWrapping="Wrap" />
                                <Button
                                    x:Uid="SaveApiAdvancedSettingsButton"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="SaveApiAdvancedSettingsButton"
                                    Click="SaveApiAdvancedSettingsButton_Click"
                                    IsEnabled="{x:Bind ViewModel.CanSaveAdvancedSettings, Mode=OneWay}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
