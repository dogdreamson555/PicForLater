<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PicForLater.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="768"
    d:DesignWidth="1024"
    mc:Ignorable="d">

    <Grid
        AutomationProperties.AutomationId="SettingsPage"
        Background="{ThemeResource AppPageBackgroundBrush}">
        <Frame
            x:Name="SettingsFrame"
            AutomationProperties.AutomationId="SettingsContentFrame"
            Background="{ThemeResource AppPageBackgroundBrush}" />
    </Grid>
</Page>
