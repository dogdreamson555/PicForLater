<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PicForLater.App.Pages.SettingsHomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PicForLater.App.Pages"
    xmlns:models="using:PicForLater.App.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="768"
    d:DesignWidth="1024"
    mc:Ignorable="d">

    <ScrollViewer
        AutomationProperties.AutomationId="SettingsHomePage"
        Background="{ThemeResource AppPageBackgroundBrush}"
        HorizontalContentAlignment="Stretch"
        HorizontalScrollMode="Disabled"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid
                x:Name="ContentPanel"
                MaxWidth="{StaticResource AppSinglePaneDetailMaxWidth}"
                Margin="{StaticResource AppPagePaddingNarrow}"
                HorizontalAlignment="Stretch"
                RowSpacing="{StaticResource AppSpacingLg}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="WidthStates">
                        <VisualState x:Name="Narrow" />
                        <VisualState x:Name="Medium">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="{StaticResource AppBreakpointMedium}" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="ContentPanel.Margin" Value="{StaticResource AppPagePaddingMedium}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Wide">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="{StaticResource AppBreakpointExpanded}" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="ContentPanel.Margin" Value="{StaticResource AppPagePaddingWide}" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>

                <StackPanel Grid.Row="0" Spacing="{StaticResource AppSpacingXs}">
                    <TextBlock x:Uid="SettingsPageTitle" Style="{StaticResource AppPageTitleTextBlockStyle}" />
                    <TextBlock x:Uid="SettingsPageSubtitle" Style="{StaticResource AppPageSubtitleTextBlockStyle}" />
                </StackPanel>

                <StackPanel
                    Grid.Row="3"
                    AutomationProperties.AutomationId="ScreenshotCaptureSection"
                    Spacing="{StaticResource AppSpacingSm}">
                    <TextBlock
                        x:Uid="ScreenshotCaptureSectionTitle"
                        Style="{StaticResource AppSectionTitleTextBlockStyle}" />
                    <Border Style="{StaticResource AppSettingsListGroupStyle}">
                        <StackPanel>
                            <Grid
                                x:Name="ScreenshotCaptureToggleRow"
                                MinHeight="72"
                                Padding="12,8"
                                ColumnSpacing="{StaticResource AppSpacingMd}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="{StaticResource AppSpacingXs}">
                                    <TextBlock
                                        x:Uid="ScreenshotCaptureToggleTitle"
                                        FontWeight="SemiBold"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Uid="ScreenshotCaptureToggleDescription"
                                        Foreground="{ThemeResource AppSecondaryTextBrush}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Uid="ScreenshotCaptureAnalysisDisclosure"
                                        Foreground="{ThemeResource AppSecondaryTextBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="ScreenshotCaptureToggle"
                                    x:Uid="ScreenshotCaptureToggle"
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="ScreenshotCaptureToggle"
                                    IsEnabled="{x:Bind ScreenshotViewModel.CanToggle, Mode=OneWay}"
                                    IsOn="{x:Bind ScreenshotViewModel.IsEnabledRequested, Mode=OneWay}"
                                    MinWidth="0"
                                    Loaded="ContentlessToggleSwitch_Loaded"
                                    OffContent="{x:Null}"
                                    OnContent="{x:Null}"
                                    Toggled="ScreenshotCaptureToggle_Toggled" />
                            </Grid>

                            <Border Height="1" Background="{ThemeResource AppDividerBrush}" />

                            <StackPanel
                                Padding="12,10"
                                Spacing="{StaticResource AppSpacingMd}">
                                <Grid
                                    x:Name="ScreenshotHotKeyRow"
                                    ColumnSpacing="{StaticResource AppSpacingMd}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3">
                                        <TextBlock
                                            x:Uid="ScreenshotHotKeyLabel"
                                            Foreground="{ThemeResource AppSecondaryTextBrush}" />
                                        <TextBlock
                                            AutomationProperties.AutomationId="ScreenshotCaptureHotKeyText"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind ScreenshotViewModel.HotKeyText, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button
                                        x:Name="ChangeScreenshotHotKeyButton"
                                        x:Uid="ChangeScreenshotHotKeyButton"
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        AutomationProperties.AutomationId="ChangeScreenshotHotKeyButton"
                                        Click="ChangeScreenshotHotKeyButton_Click"
                                        IsEnabled="{x:Bind ScreenshotViewModel.CanChangeHotKey, Mode=OneWay}" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <InfoBar
                        x:Name="ScreenshotCaptureStatusInfoBar"
                        x:Uid="ScreenshotCaptureStatusInfoBar"
                        AutomationProperties.AutomationId="ScreenshotCaptureStatusInfoBar"
                        AutomationProperties.LiveSetting="Polite"
                        IsClosable="False"
                        IsOpen="{x:Bind ScreenshotViewModel.IsInfoOpen, Mode=OneWay}"
                        Message="{x:Bind ScreenshotViewModel.InfoMessage, Mode=OneWay}"
                        Severity="{x:Bind local:SettingsHomePage.StatusSeverity(ScreenshotViewModel.InfoKind), Mode=OneWay}"
                        Visibility="{x:Bind local:SettingsHomePage.BoolToVisibility(ScreenshotViewModel.IsInfoOpen), Mode=OneWay}" />
                </StackPanel>

                <StackPanel Grid.Row="2" Spacing="{StaticResource AppSpacingSm}">
                    <TextBlock x:Uid="LocalSendSectionTitle" Style="{StaticResource AppSectionTitleTextBlockStyle}" />
                    <Border Style="{StaticResource AppSettingsListGroupStyle}">
                        <StackPanel>
                            <Grid
                                MinHeight="72"
                                Padding="12,8"
                                ColumnSpacing="{StaticResource AppSpacingMd}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel
                                    VerticalAlignment="Center"
                                    Spacing="{StaticResource AppSpacingXs}">
                                    <TextBlock
                                        x:Uid="LocalSendReceiveToggleTitle"
                                        FontWeight="SemiBold"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Uid="LocalSendReceiveToggleDescription"
                                        Foreground="{ThemeResource AppSecondaryTextBrush}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Uid="LocalSendAnalysisDisclosure"
                                        Foreground="{ThemeResource AppSecondaryTextBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="LocalSendReceiveToggle"
                                    x:Uid="LocalSendReceiveToggle"
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="LocalSendReceiveToggle"
                                    IsEnabled="{x:Bind ViewModel.CanToggleLocalSend, Mode=OneWay}"
                                    MinWidth="0"
                                    Loaded="ContentlessToggleSwitch_Loaded"
                                    OffContent="{x:Null}"
                                    OnContent="{x:Null}"
                                    Toggled="LocalSendReceiveToggle_Toggled" />
                            </Grid>

                            <Border Height="1" Background="{ThemeResource AppDividerBrush}" />

                            <StackPanel
                                Padding="12,10"
                                Spacing="{StaticResource AppSpacingSm}">
                                <Grid ColumnSpacing="{StaticResource AppSpacingMd}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="{StaticResource AppSpacingXs}">
                                        <TextBlock
                                            AutomationProperties.AutomationId="LocalSendReceiverNameText"
                                            Foreground="{ThemeResource AppSecondaryTextBrush}"
                                            Text="{x:Bind ViewModel.LocalSendReceiverName, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            AutomationProperties.AutomationId="LocalSendStatusText"
                                            AutomationProperties.LiveSetting="Polite"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind ViewModel.LocalSendStatus, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button
                                        x:Uid="BeginLocalSendPairingButton"
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        AutomationProperties.AutomationId="BeginLocalSendPairingButton"
                                        Click="BeginLocalSendPairingButton_Click"
                                        IsEnabled="{x:Bind ViewModel.CanPairLocalSend, Mode=OneWay}" />
                                </Grid>

                                <InfoBar
                                    x:Name="LocalSendStatusInfoBar"
                                    x:Uid="LocalSendStatusInfoBar"
                                    AutomationProperties.AutomationId="LocalSendStatusInfoBar"
                                    IsClosable="False"
                                    IsOpen="{x:Bind ViewModel.IsLocalSendInfoOpen, Mode=OneWay}"
                                    Message="{x:Bind ViewModel.LocalSendInfoMessage, Mode=OneWay}"
                                    Severity="{x:Bind local:SettingsHomePage.StatusSeverity(ViewModel.LocalSendInfoKind), Mode=OneWay}"
                                    Visibility="{x:Bind local:SettingsHomePage.BoolToVisibility(ViewModel.IsLocalSendInfoOpen), Mode=OneWay}" />

                                <StackPanel
                                    x:Name="LocalSendPairingPanel"
                                    AutomationProperties.AutomationId="LocalSendPairingPanel"
                                    Spacing="{StaticResource AppSpacingSm}"
                                    Visibility="{x:Bind local:SettingsHomePage.BoolToVisibility(ViewModel.IsLocalSendPairing), Mode=OneWay}">
                                    <TextBlock
                                        x:Uid="LocalSendPairingInstructions"
                                        TextWrapping="Wrap" />
                                    <StackPanel Spacing="{StaticResource AppSpacingSm}">
                                        <StackPanel Spacing="{StaticResource AppSpacingXs}">
                                            <TextBlock
                                                x:Uid="LocalSendPairingPinLabel"
                                                Foreground="{ThemeResource AppSecondaryTextBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}" />
                                            <TextBlock
                                                AutomationProperties.AutomationId="LocalSendPairingPinText"
                                                AutomationProperties.LiveSetting="Polite"
                                                FontFamily="Consolas"
                                                FontWeight="SemiBold"
                                                Style="{StaticResource SubtitleTextBlockStyle}"
                                                Text="{x:Bind ViewModel.LocalSendPairingPin, Mode=OneWay}" />
                                        </StackPanel>
                                        <TextBlock
                                            AutomationProperties.AutomationId="LocalSendPairingRemainingText"
                                            Foreground="{ThemeResource AppSecondaryTextBrush}"
                                            Text="{x:Bind ViewModel.LocalSendPairingRemaining, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                        <Button
                                            x:Uid="CancelLocalSendPairingButton"
                                            HorizontalAlignment="Left"
                                            AutomationProperties.AutomationId="CancelLocalSendPairingButton"
                                            Click="CancelLocalSendPairingButton_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <Border Height="1" Background="{ThemeResource AppDividerBrush}" />

                            <StackPanel
                                Padding="12,9,12,11"
                                Spacing="7">
                                <TextBlock
                                    x:Uid="LocalSendTrustedDevicesTitle"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    x:Uid="LocalSendTrustedDevicesEmpty"
                                    AutomationProperties.AutomationId="LocalSendTrustedDevicesEmpty"
                                    Foreground="{ThemeResource AppSecondaryTextBrush}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind local:SettingsHomePage.BoolToVisibility(ViewModel.HasNoLocalSendTrustedDevices), Mode=OneWay}" />
                                <ItemsControl
                                    x:Name="LocalSendTrustedDevicesList"
                                    x:Uid="LocalSendTrustedDevicesList"
                                    AutomationProperties.AutomationId="LocalSendTrustedDevicesList"
                                    IsEnabled="{x:Bind ViewModel.CanManageLocalSendDevices, Mode=OneWay}"
                                    ItemsSource="{x:Bind ViewModel.LocalSendTrustedDevices, Mode=OneWay}"
                                    Visibility="{x:Bind local:SettingsHomePage.BoolToVisibility(ViewModel.HasLocalSendTrustedDevices), Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="5" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:LocalSendTrustedDeviceItem">
                                            <Grid
                                                ColumnSpacing="{StaticResource AppSpacingMd}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel
                                                    VerticalAlignment="Center"
                                                    Spacing="{StaticResource AppSpacingXs}">
                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        Text="{x:Bind DisplayName, Mode=OneTime}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource AppSecondaryTextBrush}"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Text="{x:Bind PairedDescription, Mode=OneTime}" />
                                                </StackPanel>
                                                <Button
                                                    x:Uid="LocalSendRemoveDeviceButton"
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.AutomationId="{x:Bind RemoveAutomationId, Mode=OneTime}"
                                                    AutomationProperties.Name="{x:Bind RemoveAutomationName, Mode=OneTime}"
                                                    Click="RemoveLocalSendTrustedDeviceButton_Click" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="1" Spacing="{StaticResource AppSpacingSm}">
                    <TextBlock x:Uid="CurrentExecutionSectionTitle" Style="{StaticResource AppSectionTitleTextBlockStyle}" />
                    <Border Style="{StaticResource AppSettingsListGroupStyle}">
                        <StackPanel
                            x:Name="AnalysisSourceOptions"
                            x:Uid="AnalysisSourceOptions"
                            AutomationProperties.AutomationId="AnalysisSourceOptions">
                            <Grid
                                MinHeight="64"
                                Padding="12,0"
                                ColumnSpacing="{StaticResource AppSpacingMd}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <RadioButton
                                    x:Uid="LocalAnalysisSourceOption"
                                    Margin="0,6,0,10"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    AutomationProperties.AutomationId="LocalAnalysisSourceOption"
                                    Checked="AnalysisSourceRadioButton_Checked"
                                    GroupName="AnalysisSource"
                                    IsChecked="{x:Bind local:SettingsHomePage.IsSelected(ViewModel.SelectedAnalysisSourceIndex, 0), Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.CanChangeAnalysisSource, Mode=OneWay}"
                                    Tag="0">
                                    <StackPanel
                                        VerticalAlignment="Center"
                                        Spacing="{StaticResource AppSpacingXs}">
                                        <StackPanel
                                            Orientation="Horizontal"
                                            Spacing="{StaticResource AppSpacingSm}">
                                            <TextBlock
                                                x:Uid="LocalAnalysisSettingsEntryTitle"
                                                FontWeight="SemiBold" />
                                            <TextBlock
                                                x:Uid="LocalAnalysisReadyStatus"
                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}" />
                                        </StackPanel>
                                        <TextBlock
                                            x:Uid="LocalAnalysisSettingsEntryDescription"
                                            Foreground="{ThemeResource AppSecondaryTextBrush}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </RadioButton>
                                <Button
                                    x:Uid="OpenLocalAnalysisSettingsButton"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="OpenLocalAnalysisSettingsButton"
                                    Click="OpenLocalAnalysisSettingsButton_Click" />
                            </Grid>

                            <Border Height="1" Background="{ThemeResource AppDividerBrush}" />

                            <Grid
                                MinHeight="64"
                                Padding="12,0"
                                ColumnSpacing="{StaticResource AppSpacingMd}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <RadioButton
                                    x:Uid="ApiAnalysisSourceOption"
                                    Margin="0,6,0,10"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    AutomationProperties.AutomationId="ApiAnalysisSourceOption"
                                    Checked="AnalysisSourceRadioButton_Checked"
                                    GroupName="AnalysisSource"
                                    IsChecked="{x:Bind local:SettingsHomePage.IsSelected(ViewModel.SelectedAnalysisSourceIndex, 1), Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.CanSelectApiAnalysis, Mode=OneWay}"
                                    Tag="1">
                                    <StackPanel
                                        VerticalAlignment="Center"
                                        Spacing="{StaticResource AppSpacingXs}">
                                        <StackPanel
                                            Orientation="Horizontal"
                                            Spacing="{StaticResource AppSpacingSm}">
                                            <TextBlock
                                                x:Uid="ApiAnalysisSettingsEntryTitle"
                                                FontWeight="SemiBold" />
                                            <TextBlock
                                                AutomationProperties.AutomationId="ApiConfigurationStatusText"
                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind ViewModel.ApiConfigurationStatus, Mode=OneWay}" />
                                        </StackPanel>
                                        <TextBlock
                                            x:Uid="ApiAnalysisSettingsEntryDescription"
                                            Foreground="{ThemeResource AppSecondaryTextBrush}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </RadioButton>
                                <Button
                                    x:Uid="OpenApiAnalysisSettingsButton"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="OpenApiAnalysisSettingsButton"
                                    Click="OpenApiAnalysisSettingsButton_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="4" Spacing="{StaticResource AppSpacingSm}">
                    <TextBlock x:Uid="AppearanceSectionTitle" Style="{StaticResource AppSectionTitleTextBlockStyle}" />
                    <Border
                        Padding="12,0,12,8"
                        Style="{StaticResource AppSettingsListSectionStyle}">
                        <RadioButtons
                            x:Name="ThemeOptions"
                            x:Uid="ThemeOptions"
                            AutomationProperties.AutomationId="ThemeOptions"
                            MaxColumns="1"
                            SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}">
                            <RadioButton
                                x:Uid="SystemThemeOption"
                                AutomationProperties.AutomationId="SystemThemeOption" />
                            <RadioButton
                                x:Uid="LightThemeOption"
                                AutomationProperties.AutomationId="LightThemeOption" />
                            <RadioButton
                                x:Uid="DarkThemeOption"
                                AutomationProperties.AutomationId="DarkThemeOption" />
                        </RadioButtons>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="5" Spacing="{StaticResource AppSpacingSm}">
                    <TextBlock
                        x:Uid="InterfaceLanguageSectionTitle"
                        Style="{StaticResource AppSectionTitleTextBlockStyle}" />
                    <Border Style="{StaticResource AppSettingsListGroupStyle}">
                        <Grid
                            x:Name="InterfaceLanguageRow"
                            Padding="12,11,12,3"
                            ColumnSpacing="{StaticResource AppSpacingLg}"
                            RowSpacing="{StaticResource AppSpacingSm}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition
                                    x:Name="InterfaceLanguageControlColumn"
                                    Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition x:Name="InterfaceLanguageSelectionRow" Height="0" />
                            </Grid.RowDefinitions>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="InterfaceLanguageWidthStates">
                                    <VisualState x:Name="InterfaceLanguageNarrow">
                                        <VisualState.StateTriggers>
                                            <AdaptiveTrigger MinWindowWidth="0" />
                                        </VisualState.StateTriggers>
                                        <VisualState.Setters>
                                            <Setter Target="InterfaceLanguageControlColumn.Width" Value="0" />
                                            <Setter Target="InterfaceLanguageComboBox.(Grid.Row)" Value="1" />
                                            <Setter Target="InterfaceLanguageComboBox.(Grid.Column)" Value="0" />
                                            <Setter Target="InterfaceLanguageComboBox.HorizontalAlignment" Value="Stretch" />
                                            <Setter Target="InterfaceLanguageComboBox.MinWidth" Value="0" />
                                            <Setter Target="InterfaceLanguageComboBox.Margin" Value="0" />
                                            <Setter Target="InterfaceLanguageRow.RowSpacing" Value="{StaticResource AppSpacingSm}" />
                                            <Setter Target="InterfaceLanguageSelectionRow.Height" Value="Auto" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="InterfaceLanguageWide">
                                        <VisualState.StateTriggers>
                                            <AdaptiveTrigger MinWindowWidth="{StaticResource AppBreakpointMedium}" />
                                        </VisualState.StateTriggers>
                                        <VisualState.Setters>
                                            <Setter Target="InterfaceLanguageControlColumn.Width" Value="Auto" />
                                            <Setter Target="InterfaceLanguageComboBox.(Grid.Row)" Value="0" />
                                            <Setter Target="InterfaceLanguageComboBox.(Grid.Column)" Value="1" />
                                            <Setter Target="InterfaceLanguageComboBox.HorizontalAlignment" Value="Right" />
                                            <Setter Target="InterfaceLanguageComboBox.MinWidth" Value="220" />
                                            <Setter Target="InterfaceLanguageComboBox.Margin" Value="0" />
                                            <Setter Target="InterfaceLanguageRow.RowSpacing" Value="0" />
                                            <Setter Target="InterfaceLanguageSelectionRow.Height" Value="0" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <StackPanel
                                Grid.Row="0"
                                Spacing="{StaticResource AppSpacingXs}">
                                <TextBlock
                                    x:Uid="InterfaceLanguageTitle"
                                    FontWeight="SemiBold"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Uid="InterfaceLanguageDescription"
                                    Foreground="{ThemeResource AppSecondaryTextBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox
                                x:Name="InterfaceLanguageComboBox"
                                x:Uid="InterfaceLanguageComboBox"
                                Grid.Column="1"
                                AutomationProperties.AutomationId="InterfaceLanguageComboBox"
                                VerticalAlignment="Center"
                                MaxWidth="320"
                                SelectedIndex="{x:Bind ViewModel.SelectedInterfaceLanguageIndex, Mode=TwoWay}"
                                SelectionChanged="InterfaceLanguageComboBox_SelectionChanged">
                                <ComboBoxItem
                                    x:Uid="SystemInterfaceLanguageOption"
                                    AutomationProperties.AutomationId="SystemInterfaceLanguageOption" />
                                <ComboBoxItem
                                    x:Uid="SimplifiedChineseInterfaceLanguageOption"
                                    AutomationProperties.AutomationId="SimplifiedChineseInterfaceLanguageOption" />
                                <ComboBoxItem
                                    x:Uid="TraditionalChineseInterfaceLanguageOption"
                                    AutomationProperties.AutomationId="TraditionalChineseInterfaceLanguageOption" />
                                <ComboBoxItem
                                    x:Uid="EnglishInterfaceLanguageOption"
                                    AutomationProperties.AutomationId="EnglishInterfaceLanguageOption" />
                            </ComboBox>
                        </Grid>
                    </Border>
                    <InfoBar
                        x:Name="InterfaceLanguageStatusInfoBar"
                        x:Uid="InterfaceLanguageStatusInfoBar"
                        AutomationProperties.AutomationId="InterfaceLanguageStatusInfoBar"
                        AutomationProperties.LiveSetting="Polite"
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.IsInterfaceLanguageStatusOpen, Mode=OneWay}"
                        Message="{x:Bind ViewModel.InterfaceLanguageStatusMessage, Mode=OneWay}"
                        Severity="{x:Bind local:SettingsHomePage.StatusSeverity(ViewModel.InterfaceLanguageStatusKind), Mode=OneWay}"
                        Visibility="{x:Bind local:SettingsHomePage.BoolToVisibility(ViewModel.IsInterfaceLanguageStatusOpen), Mode=OneWay}" />
                </StackPanel>

                <StackPanel Grid.Row="6" Spacing="{StaticResource AppSpacingSm}">
                    <TextBlock
                        x:Uid="AboutUpdatesSectionTitle"
                        Style="{StaticResource AppSectionTitleTextBlockStyle}" />
                    <Border Style="{StaticResource AppSettingsListGroupStyle}">
                        <StackPanel>
                            <Grid
                                MinHeight="64"
                                Padding="12,8"
                                ColumnSpacing="{StaticResource AppSpacingMd}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel
                                    VerticalAlignment="Center"
                                    Spacing="{StaticResource AppSpacingXs}">
                                    <TextBlock
                                        x:Uid="AboutUpdatesAppName"
                                        FontWeight="SemiBold"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        AutomationProperties.AutomationId="CurrentAppVersionText"
                                        Foreground="{ThemeResource AppSecondaryTextBrush}"
                                        Text="{x:Bind ViewModel.CurrentAppVersion, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <Button
                                    x:Name="CheckForUpdatesButton"
                                    x:Uid="CheckForUpdatesButton"
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="CheckForUpdatesButton"
                                    Click="CheckForUpdatesButton_Click"
                                    IsEnabled="{x:Bind ViewModel.CanCheckForUpdates, Mode=OneWay}">
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="{StaticResource AppSpacingSm}">
                                        <ProgressRing
                                            Width="16"
                                            Height="16"
                                            IsActive="{x:Bind ViewModel.IsCheckingForUpdates, Mode=OneWay}"
                                            IsTabStop="False"
                                            Visibility="{x:Bind local:SettingsHomePage.BoolToVisibility(ViewModel.IsCheckingForUpdates), Mode=OneWay}" />
                                        <TextBlock x:Uid="CheckForUpdatesButtonText" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <InfoBar
                                x:Name="UpdateStatusInfoBar"
                                x:Uid="UpdateStatusInfoBar"
                                Margin="12,0,12,12"
                                AutomationProperties.AutomationId="UpdateStatusInfoBar"
                                AutomationProperties.LiveSetting="Polite"
                                IsClosable="False"
                                IsOpen="{x:Bind ViewModel.IsUpdateStatusOpen, Mode=OneWay}"
                                Message="{x:Bind ViewModel.UpdateStatusMessage, Mode=OneWay}"
                                Severity="{x:Bind local:SettingsHomePage.StatusSeverity(ViewModel.UpdateStatusKind), Mode=OneWay}"
                                Visibility="{x:Bind local:SettingsHomePage.BoolToVisibility(ViewModel.IsUpdateStatusOpen), Mode=OneWay}">
                                <InfoBar.ActionButton>
                                    <Button
                                        x:Uid="ViewReleasePageButton"
                                        AutomationProperties.AutomationId="ViewReleasePageButton"
                                        Click="ViewReleasePageButton_Click"
                                        Visibility="{x:Bind local:SettingsHomePage.BoolToVisibility(ViewModel.IsReleasePageAvailable), Mode=OneWay}" />
                                </InfoBar.ActionButton>
                            </InfoBar>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
