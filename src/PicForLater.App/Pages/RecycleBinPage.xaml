<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PicForLater.App.Pages.RecycleBinPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PicForLater.App.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:PicForLater.App.Models"
    d:DesignHeight="768"
    d:DesignWidth="1024"
    mc:Ignorable="d">

    <Grid
        x:Name="LayoutRoot"
        AutomationProperties.AutomationId="RecycleBinPage"
        Background="{ThemeResource AppPageBackgroundBrush}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowWidthStates">
                <VisualState x:Name="Narrow" />
                <VisualState x:Name="Medium">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource AppBreakpointMedium}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderSurface.Padding" Value="{StaticResource AppPrimaryPagePaddingMedium}" />
                        <Setter Target="CollectionHost.Padding" Value="{StaticResource AppCollectionViewportPaddingMedium}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource AppBreakpointExpanded}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderSurface.Padding" Value="{StaticResource AppPrimaryPagePaddingWide}" />
                        <Setter Target="CollectionHost.Padding" Value="{StaticResource AppCollectionViewportPaddingWide}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="HeaderSurface"
            Padding="{StaticResource AppPrimaryPagePaddingNarrow}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="{StaticResource AppSpacingLg}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="{StaticResource AppSpacingXs}">
                    <TextBlock x:Uid="RecycleBinPageTitle" Style="{StaticResource AppPageTitleTextBlockStyle}" />
                    <TextBlock
                        x:Uid="RecycleBinPageSubtitle"
                        Style="{StaticResource AppPageSubtitleTextBlockStyle}" />
                    <TextBlock
                        AutomationProperties.AutomationId="RecycleBinSelectionSummary"
                        Foreground="{ThemeResource AppSecondaryTextBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.SelectionSummary, Mode=OneWay}"
                        Visibility="{x:Bind local:RecycleBinPage.BoolToVisibility(ViewModel.IsSelectionModeActive), Mode=OneWay}" />
                </StackPanel>
                <CommandBar
                    Grid.Column="1"
                    AutomationProperties.AutomationId="RecycleBinCommandBar"
                    Background="Transparent"
                    DefaultLabelPosition="Right"
                    IsDynamicOverflowEnabled="True">
                    <AppBarButton
                        x:Name="RecycleBinSelectionModeButton"
                        x:Uid="RecycleBinSelectionModeButton"
                        AutomationProperties.AutomationId="RecycleBinSelectionModeButton"
                        Click="RecycleBinSelectionModeButton_Click"
                        IsEnabled="{x:Bind ViewModel.HasItems, Mode=OneWay}"
                        Visibility="{x:Bind local:RecycleBinPage.InvertBoolToVisibility(ViewModel.IsSelectionModeActive), Mode=OneWay}">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="{StaticResource AppEnterSelectionIconGlyph}" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        x:Name="RecycleBinSelectAllButton"
                        x:Uid="RecycleBinSelectAllButton"
                        AutomationProperties.AutomationId="RecycleBinSelectAllButton"
                        Click="RecycleBinSelectAllButton_Click"
                        Visibility="{x:Bind local:RecycleBinPage.BoolToVisibility(ViewModel.IsSelectionModeActive), Mode=OneWay}">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="{StaticResource AppSelectAllIconGlyph}" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        x:Uid="RestoreButton"
                        AutomationProperties.AutomationId="RestoreButton"
                        Click="RestoreButton_Click"
                        IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                        Visibility="{x:Bind local:RecycleBinPage.BoolToVisibility(ViewModel.HasSelection), Mode=OneWay}">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE777;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        x:Uid="PermanentDeleteButton"
                        AutomationProperties.AutomationId="PermanentDeleteButton"
                        Click="PermanentDeleteButton_Click"
                        IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                        Visibility="{x:Bind local:RecycleBinPage.BoolToVisibility(ViewModel.HasSelection), Mode=OneWay}">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="{StaticResource AppDeleteIconGlyph}" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        x:Name="RecycleBinCancelSelectionButton"
                        x:Uid="RecycleBinCancelSelectionButton"
                        AutomationProperties.AutomationId="RecycleBinCancelSelectionButton"
                        Click="RecycleBinCancelSelectionButton_Click"
                        Visibility="{x:Bind local:RecycleBinPage.BoolToVisibility(ViewModel.IsSelectionModeActive), Mode=OneWay}">
                        <AppBarButton.Icon>
                            <SymbolIcon Symbol="Cancel" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar>
            </Grid>

            <InfoBar
                x:Uid="RecycleBinStatusInfoBar"
                Grid.Row="1"
                Margin="0,12,0,0"
                AutomationProperties.AutomationId="RecycleBinStatusInfoBar"
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Visibility="{x:Bind local:RecycleBinPage.BoolToVisibility(ViewModel.HasStatusMessage), Mode=OneWay}" />
        </Grid>

        <Grid
            x:Name="CollectionHost"
            Grid.Row="1"
            Padding="{StaticResource AppCollectionViewportPaddingNarrow}">
            <StackPanel
                x:Name="RecycleBinLoadingState"
                x:Load="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                AutomationProperties.AutomationId="RecycleBinLoadingState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="{StaticResource AppSpacingSm}">
                <ProgressRing Width="32" Height="32" AutomationProperties.AccessibilityView="Raw" IsActive="True" />
                <TextBlock x:Uid="RecycleBinLoadingTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
            </StackPanel>

            <StackPanel
                x:Name="RecycleBinEmptyState"
                x:Load="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
                MaxWidth="440"
                AutomationProperties.AutomationId="RecycleBinEmptyState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="{StaticResource AppSpacingSm}">
                <FontIcon
                    FontSize="{StaticResource AppEmptyStateIconSize}"
                    AutomationProperties.AccessibilityView="Raw"
                    Foreground="{ThemeResource AppSecondaryTextBrush}"
                    Glyph="{StaticResource AppRecycleBinIconGlyph}" />
                <TextBlock
                    x:Uid="RecycleBinEmptyTitle"
                    AutomationProperties.AutomationId="RecycleBinEmptyTitle"
                    HorizontalAlignment="Center"
                    Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock x:Uid="RecycleBinEmptyMessage" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel
                x:Name="RecycleBinErrorState"
                x:Load="{x:Bind ViewModel.HasError, Mode=OneWay}"
                MaxWidth="440"
                AutomationProperties.AutomationId="RecycleBinErrorState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="{StaticResource AppSpacingSm}">
                <FontIcon FontSize="{StaticResource AppEmptyStateIconSize}" AutomationProperties.AccessibilityView="Raw" Glyph="&#xEA39;" />
                <TextBlock x:Uid="RecycleBinErrorTitle" HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock x:Uid="RecycleBinErrorMessage" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>

            <GridView
                x:Name="RecycleBinGridView"
                x:Uid="RecycleBinGridView"
                x:Load="{x:Bind ViewModel.HasItems, Mode=OneWay}"
                AutomationProperties.AutomationId="RecycleBinGridView"
                ContainerContentChanging="RecycleBinGridView_ContainerContentChanging"
                ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}"
                SelectionChanged="RecycleBinGridView_SelectionChanged"
                SelectionMode="Single"
                SizeChanged="RecycleBinGridView_SizeChanged">
                <GridView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource DefaultGridViewItemStyle}" TargetType="GridViewItem">
                        <Setter Property="Margin" Value="0,0,12,12" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:LibraryItem">
                        <Border
                            Height="228"
                            Background="{ThemeResource AppCardBackgroundBrush}"
                            BorderBrush="{ThemeResource AppCardStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource AppCardCornerRadius}">
                            <Border.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem
                                        x:Uid="RecycleBinContextRestoreMenuItem"
                                        AutomationProperties.AutomationId="{x:Bind local:RecycleBinPage.GetContextRestoreAutomationId(Id), Mode=OneTime}"
                                        Click="ContextRestoreMenuItem_Click"
                                        Tag="{x:Bind Mode=OneTime}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE777;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem
                                        x:Uid="RecycleBinContextSelectMenuItem"
                                        AutomationProperties.AutomationId="{x:Bind local:RecycleBinPage.GetContextSelectAutomationId(Id), Mode=OneTime}"
                                        Click="ContextSelectMenuItem_Click"
                                        Tag="{x:Bind Mode=OneTime}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="{StaticResource AppEnterSelectionIconGlyph}" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem
                                        x:Uid="RecycleBinContextPermanentDeleteMenuItem"
                                        AutomationProperties.AutomationId="{x:Bind local:RecycleBinPage.GetContextPermanentDeleteAutomationId(Id), Mode=OneTime}"
                                        Click="ContextPermanentDeleteMenuItem_Click"
                                        Icon="Delete"
                                        Tag="{x:Bind Mode=OneTime}" />
                                </MenuFlyout>
                            </Border.ContextFlyout>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="152" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Image AutomationProperties.AccessibilityView="Raw" Source="{x:Bind ThumbnailUri, Mode=OneTime}" Stretch="UniformToFill" />
                                <StackPanel Grid.Row="1" Padding="12,8" Spacing="2">
                                    <TextBlock
                                        MaxLines="1"
                                        Style="{StaticResource AppCardTitleTextBlockStyle}"
                                        Text="{x:Bind Title, Mode=OneTime}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap"
                                        ToolTipService.ToolTip="{x:Bind Title, Mode=OneTime}" />
                                    <TextBlock
                                        MaxLines="1"
                                        Style="{StaticResource AppMetadataTextBlockStyle}"
                                        Text="{x:Bind CategorySummary, Mode=OneTime}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap"
                                        ToolTipService.ToolTip="{x:Bind CategorySummary, Mode=OneTime}" />
                                    <TextBlock
                                        Style="{StaticResource AppMetadataTextBlockStyle}"
                                        Text="{x:Bind CreatedDisplay, Mode=OneTime}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Loaded="RecycleBinItemsWrapGrid_Loaded" Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
            </GridView>
        </Grid>
    </Grid>
</Page>
