<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PicForLater.App.Pages.LocalAnalysisSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PicForLater.App.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:PicForLater.App.Models"
    d:DesignHeight="768"
    d:DesignWidth="1024"
    mc:Ignorable="d">

    <ScrollViewer
        AutomationProperties.AutomationId="LocalAnalysisSettingsPage"
        Background="{ThemeResource AppPageBackgroundBrush}"
        HorizontalContentAlignment="Stretch"
        HorizontalScrollMode="Disabled"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <Grid x:Name="PageRoot">
        <StackPanel
            x:Name="ContentPanel"
            MaxWidth="{StaticResource AppSinglePaneDetailMaxWidth}"
            Margin="{StaticResource AppPagePaddingNarrow}"
            HorizontalAlignment="Stretch"
            Spacing="{StaticResource AppSpacingXl}">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="WidthStates">
                    <VisualState x:Name="Narrow" />
                    <VisualState x:Name="Medium">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="{StaticResource AppBreakpointMedium}" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="ContentPanel.Margin" Value="{StaticResource AppPagePaddingMedium}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Wide">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="{StaticResource AppBreakpointExpanded}" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="ContentPanel.Margin" Value="{StaticResource AppPagePaddingWide}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid x:Name="PageHeader">
                <Button
                    x:Name="SettingsBackButton"
                    x:Uid="SettingsBackButton"
                    Style="{StaticResource AppBackButtonStyle}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    AutomationProperties.AutomationId="SettingsBackButton"
                    Click="SettingsBackButton_Click">
                    <FontIcon
                        AutomationProperties.AccessibilityView="Raw"
                        FontSize="20"
                        Glyph="{StaticResource AppBackIconGlyph}" />
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Left" Modifiers="Menu" />
                    </Button.KeyboardAccelerators>
                </Button>
                <StackPanel
                    x:Name="PageHeaderContent"
                    Margin="52,0,0,0"
                    Spacing="{StaticResource AppSpacingXs}">
                    <TextBlock x:Uid="LocalAnalysisSettingsPageTitle" Style="{StaticResource AppPageTitleTextBlockStyle}" />
                    <TextBlock x:Uid="LocalAnalysisSettingsPageSubtitle" Style="{StaticResource AppPageSubtitleTextBlockStyle}" />
                </StackPanel>
            </Grid>

            <StackPanel Spacing="{StaticResource AppSpacingMd}">
                <StackPanel Spacing="{StaticResource AppSpacingXs}">
                    <TextBlock x:Uid="LocalInferenceComponentSectionTitle" Style="{StaticResource AppSectionTitleTextBlockStyle}" />
                    <TextBlock
                        x:Uid="LocalInferenceComponentSectionDescription"
                        Foreground="{ThemeResource AppSecondaryTextBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <Border
                    Padding="12"
                    Style="{StaticResource AppSettingsListSectionStyle}">
                    <Grid ColumnSpacing="{StaticResource AppSpacingLg}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="{StaticResource AppSpacingXs}">
                            <TextBlock x:Uid="LocalInferenceComponentStatusTitle" FontWeight="SemiBold" />
                            <TextBlock
                                AutomationProperties.AutomationId="LocalInferenceComponentStatusText"
                                AutomationProperties.LiveSetting="Polite"
                                Foreground="{ThemeResource AppSecondaryTextBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.LocalInferenceComponentStatusMessage, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="{StaticResource AppSpacingSm}">
                            <Button
                                x:Uid="InstallLocalInferenceComponentButton"
                                AutomationProperties.AutomationId="InstallLocalInferenceComponentButton"
                                Click="InstallLocalInferenceComponentButton_Click"
                                Content="{x:Bind ViewModel.LocalInferenceComponentActionText, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.CanInstallLocalInferenceComponent, Mode=OneWay}" />
                            <Button
                                x:Uid="RemoveLocalInferenceComponentButton"
                                AutomationProperties.AutomationId="RemoveLocalInferenceComponentButton"
                                Click="RemoveLocalInferenceComponentButton_Click"
                                IsEnabled="{x:Bind ViewModel.CanRemoveLocalInferenceComponent, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Spacing="{StaticResource AppSpacingSm}">
                <TextBlock x:Uid="AnalysisSectionTitle" Style="{StaticResource AppSectionTitleTextBlockStyle}" />
                <TextBlock
                    x:Uid="AnalysisSectionDescription"
                    Foreground="{ThemeResource AppSecondaryTextBrush}"
                    TextWrapping="Wrap" />
                <Border
                    Padding="12,0,12,8"
                    Style="{StaticResource AppSettingsListSectionStyle}">
                    <RadioButtons
                        x:Name="AnalysisModeOptions"
                        AutomationProperties.AutomationId="AnalysisModeOptions"
                        IsEnabled="{x:Bind local:SettingsPage.Not(ViewModel.IsWorking), Mode=OneWay}"
                        SelectedIndex="{x:Bind ViewModel.SelectedAnalysisModeIndex, Mode=OneWay}"
                        SelectionChanged="AnalysisModeOptions_SelectionChanged">
                        <RadioButton x:Uid="OcrOnlyAnalysisOption" AutomationProperties.AutomationId="OcrOnlyAnalysisOption" />
                        <RadioButton x:Uid="BalancedAnalysisOption" AutomationProperties.AutomationId="BalancedAnalysisOption" />
                        <RadioButton x:Uid="AlwaysEnhanceAnalysisOption" AutomationProperties.AutomationId="AlwaysEnhanceAnalysisOption" />
                    </RadioButtons>
                </Border>
            </StackPanel>

            <StackPanel Spacing="{StaticResource AppSpacingSm}">
                <TextBlock x:Uid="InferenceAccelerationSectionTitle" Style="{StaticResource AppSectionTitleTextBlockStyle}" />
                <TextBlock
                    x:Uid="InferenceAccelerationSectionDescription"
                    Foreground="{ThemeResource AppSecondaryTextBrush}"
                    TextWrapping="Wrap" />
                <Border
                    Padding="12,0,12,14"
                    Style="{StaticResource AppSettingsListSectionStyle}">
                    <StackPanel Spacing="{StaticResource AppSpacingMd}">
                        <RadioButtons
                            x:Name="CudaInferenceAccelerationOptions"
                            x:Uid="InferenceAccelerationOptions"
                            AutomationProperties.AutomationId="InferenceAccelerationOptions"
                            IsEnabled="{x:Bind local:SettingsPage.Not(ViewModel.IsWorking), Mode=OneWay}"
                            SelectedIndex="{x:Bind ViewModel.SelectedInferenceAccelerationIndex, Mode=OneWay}"
                            SelectionChanged="InferenceAccelerationOptions_SelectionChanged"
                            Visibility="{x:Bind local:SettingsPage.BoolToVisibility(ViewModel.IsCudaAvailable), Mode=OneWay}">
                            <RadioButton x:Uid="AutomaticAccelerationOption" AutomationProperties.AutomationId="AutomaticAccelerationOption" />
                            <RadioButton x:Uid="CpuAccelerationOption" AutomationProperties.AutomationId="CpuAccelerationOption" />
                            <RadioButton x:Uid="CudaGpuAccelerationOption" AutomationProperties.AutomationId="CudaGpuAccelerationOption" />
                        </RadioButtons>
                        <RadioButtons
                            x:Name="DirectMlInferenceAccelerationOptions"
                            x:Uid="InferenceAccelerationOptions"
                            AutomationProperties.AutomationId="InferenceAccelerationOptions"
                            IsEnabled="{x:Bind local:SettingsPage.Not(ViewModel.IsWorking), Mode=OneWay}"
                            SelectedIndex="{x:Bind ViewModel.SelectedInferenceAccelerationIndex, Mode=OneWay}"
                            SelectionChanged="InferenceAccelerationOptions_SelectionChanged"
                            Visibility="{x:Bind local:SettingsPage.BoolToVisibility(ViewModel.IsDirectMlAvailable), Mode=OneWay}">
                            <RadioButton x:Uid="AutomaticAccelerationOption" AutomationProperties.AutomationId="AutomaticAccelerationOption" />
                            <RadioButton x:Uid="DirectMlGpuAccelerationOption" AutomationProperties.AutomationId="DirectMlGpuAccelerationOption" />
                            <RadioButton x:Uid="CpuAccelerationOption" AutomationProperties.AutomationId="CpuAccelerationOption" />
                        </RadioButtons>
                        <TextBlock
                            AutomationProperties.AutomationId="InferenceAccelerationStatusText"
                            Foreground="{ThemeResource AppSecondaryTextBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.InferenceAccelerationStatusMessage, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <InfoBar
                            x:Uid="NvidiaEnvironmentInfoBar"
                            AutomationProperties.AutomationId="NvidiaEnvironmentInfoBar"
                            IsClosable="False"
                            IsOpen="True"
                            Message="{x:Bind ViewModel.NvidiaEnvironmentStatusMessage, Mode=OneWay}"
                            Severity="{x:Bind local:SettingsPage.NvidiaEnvironmentSeverity(ViewModel.NvidiaEnvironmentState), Mode=OneWay}"
                            Visibility="{x:Bind local:SettingsPage.BoolToVisibility(ViewModel.IsCudaAvailable), Mode=OneWay}" />
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="{StaticResource AppSpacingSm}"
                            Visibility="{x:Bind local:SettingsPage.BoolToVisibility(ViewModel.IsCudaAvailable), Mode=OneWay}">
                            <Button
                                x:Uid="DetectNvidiaEnvironmentButton"
                                AutomationProperties.AutomationId="DetectNvidiaEnvironmentButton"
                                Click="DetectNvidiaEnvironmentButton_Click"
                                IsEnabled="{x:Bind local:SettingsPage.Not(ViewModel.IsWorking), Mode=OneWay}" />
                            <Button
                                x:Uid="InstallNvidiaRuntimeButton"
                                AutomationProperties.AutomationId="InstallNvidiaRuntimeButton"
                                Click="InstallNvidiaRuntimeButton_Click"
                                IsEnabled="{x:Bind local:SettingsPage.Not(ViewModel.IsWorking), Mode=OneWay}"
                                Visibility="{x:Bind local:SettingsPage.BoolToVisibility(ViewModel.IsNvidiaRuntimeInstallAvailable), Mode=OneWay}" />
                            <HyperlinkButton
                                x:Uid="OpenNvidiaDriverPageButton"
                                AutomationProperties.AutomationId="OpenNvidiaDriverPageButton"
                                NavigateUri="https://www.nvidia.com/en-us/drivers/"
                                Visibility="{x:Bind local:SettingsPage.BoolToVisibility(ViewModel.IsNvidiaDriverHelpVisible), Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="{StaticResource AppSpacingMd}">
                <StackPanel Spacing="{StaticResource AppSpacingXs}">
                    <TextBlock x:Uid="RecommendedModelsSectionTitle" Style="{StaticResource AppSectionTitleTextBlockStyle}" />
                    <TextBlock
                        x:Uid="RecommendedModelsSectionDescription"
                        Foreground="{ThemeResource AppSecondaryTextBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <Border Style="{StaticResource AppSettingsListGroupStyle}">
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.RecommendedModels, Mode=OneWay}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:RecommendedModelItem">
                                <Border
                                    Padding="12,10"
                                    BorderBrush="{ThemeResource AppDividerBrush}"
                                    BorderThickness="0,0,0,1">
                                    <Grid ColumnSpacing="{StaticResource AppSpacingSm}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="{StaticResource AppSpacingXs}">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Name, Mode=OneTime}" TextWrapping="Wrap" />
                                        <TextBlock
                                            Foreground="{ThemeResource AppSecondaryTextBrush}"
                                            Text="{x:Bind Description, Mode=OneTime}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        AutomationProperties.AutomationId="{x:Bind AutomationId, Mode=OneTime}"
                                        Click="RecommendedModelActionButton_Click"
                                        Content="{x:Bind ActionText, Mode=OneTime}"
                                        IsEnabled="{x:Bind IsActionEnabled, Mode=OneWay}"
                                        Tag="{x:Bind Id, Mode=OneTime}" />
                                    <Button
                                        x:Uid="RecommendedModelInfoButton"
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        AutomationProperties.AutomationId="{x:Bind DetailsAutomationId, Mode=OneTime}"
                                        Click="RecommendedModelInfoButton_Click"
                                        Style="{StaticResource AppInfoButtonStyle}"
                                        Tag="{x:Bind Id, Mode=OneTime}">
                                        <FontIcon
                                            AutomationProperties.AccessibilityView="Raw"
                                            Glyph="{StaticResource AppInfoIconGlyph}" />
                                    </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </Border>
            </StackPanel>

            <StackPanel Spacing="{StaticResource AppSpacingMd}">
                <StackPanel Spacing="{StaticResource AppSpacingXs}">
                    <TextBlock x:Uid="AdvancedSettingsSectionTitle" Style="{StaticResource AppSectionTitleTextBlockStyle}" />
                    <TextBlock
                        x:Uid="AdvancedSettingsSectionDescription"
                        Foreground="{ThemeResource AppSecondaryTextBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <Border Style="{StaticResource AppSettingsListGroupStyle}">
                    <StackPanel>
                        <Grid Padding="12,7,12,12" ColumnSpacing="{StaticResource AppSpacingLg}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="{StaticResource AppSpacingXs}">
                                <TextBlock x:Uid="VisionSlotTitle" FontWeight="SemiBold" />
                                <TextBlock
                                    x:Uid="VisionSlotDescription"
                                    Foreground="{ThemeResource AppSecondaryTextBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox
                                x:Name="VisionModelComboBox"
                                x:Uid="VisionModelComboBox"
                                Grid.Column="1"
                                MinWidth="240"
                                MaxWidth="320"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="VisionModelComboBox"
                                DisplayMemberPath="DisplayName"
                                IsEnabled="{x:Bind local:SettingsPage.Not(ViewModel.IsWorking), Mode=OneWay}"
                                ItemsSource="{x:Bind ViewModel.VisionOptions, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedVisionOption, Mode=OneWay}"
                                SelectionChanged="VisionModelComboBox_SelectionChanged" />
                        </Grid>

                        <Border Height="1" Background="{ThemeResource AppDividerBrush}" />

                        <Grid Padding="12" ColumnSpacing="{StaticResource AppSpacingLg}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="{StaticResource AppSpacingXs}">
                                <TextBlock x:Uid="TextCompositionSlotTitle" FontWeight="SemiBold" />
                                <TextBlock
                                    x:Uid="TextCompositionSlotDescription"
                                    Foreground="{ThemeResource AppSecondaryTextBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox
                                x:Name="TextCompositionModelComboBox"
                                x:Uid="TextCompositionModelComboBox"
                                Grid.Column="1"
                                MinWidth="240"
                                MaxWidth="320"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="TextCompositionModelComboBox"
                                DisplayMemberPath="DisplayName"
                                IsEnabled="{x:Bind local:SettingsPage.Not(ViewModel.IsWorking), Mode=OneWay}"
                                ItemsSource="{x:Bind ViewModel.TextCompositionOptions, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedTextCompositionOption, Mode=OneWay}"
                                SelectionChanged="TextCompositionModelComboBox_SelectionChanged" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid ColumnSpacing="{StaticResource AppSpacingMd}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Uid="ModelPackagesSectionTitle"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold" />
                    <Button
                        x:Name="ImportModelPackageButton"
                        x:Uid="ImportModelPackageButton"
                        Grid.Column="1"
                        AutomationProperties.AutomationId="ImportModelPackageButton"
                        Click="ImportModelPackageButton_Click"
                        IsEnabled="{x:Bind local:SettingsPage.Not(ViewModel.IsWorking), Mode=OneWay}" />
                </Grid>

                <Border
                    Padding="0"
                    Style="{StaticResource AppSettingsListGroupStyle}">
                    <StackPanel>
                        <Button
                            x:Name="InstalledModelsExpander"
                            x:Uid="InstalledModelsExpander"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            AutomationProperties.AutomationId="InstalledModelsExpander"
                            AutomationProperties.HelpText="{x:Bind ViewModel.InstalledModelsSummary, Mode=OneWay}"
                            Click="InstalledModelsExpander_Click"
                            IsHitTestVisible="{x:Bind local:SettingsPage.HasItems(ViewModel.InstalledPackages.Count), Mode=OneWay}"
                            IsTabStop="{x:Bind local:SettingsPage.HasItems(ViewModel.InstalledPackages.Count), Mode=OneWay}"
                            Style="{StaticResource SubtleButtonStyle}">
                            <Grid
                                MinHeight="48"
                                Padding="8,2,8,4"
                                ColumnSpacing="{StaticResource AppSpacingMd}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    VerticalAlignment="Center"
                                    AutomationProperties.AccessibilityView="Raw"
                                    Glyph="{StaticResource AppModelPackageIconGlyph}" />
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="{StaticResource AppSpacingXs}">
                                    <TextBlock x:Uid="InstalledModelsSectionTitle" FontWeight="SemiBold" />
                                    <TextBlock
                                        Foreground="{ThemeResource AppSecondaryTextBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind ViewModel.InstalledModelsSummary, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <FontIcon
                                    x:Name="InstalledModelsChevron"
                                    Grid.Column="2"
                                    Width="20"
                                    Height="20"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AccessibilityView="Raw"
                                    Glyph="&#xE70D;"
                                    Visibility="{x:Bind local:SettingsPage.CountToNonEmptyVisibility(ViewModel.InstalledPackages.Count), Mode=OneWay}" />
                            </Grid>
                        </Button>
                        <StackPanel
                            x:Name="InstalledModelsContent"
                            Padding="8,0,8,0"
                            Spacing="{StaticResource AppSpacingSm}"
                            Visibility="Collapsed">
                            <ItemsRepeater
                                ElementPrepared="InstalledModelsRepeater_ElementPrepared"
                                ItemsSource="{x:Bind ViewModel.InstalledPackages, Mode=OneWay}">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="models:InstalledModelPackageItem">
                                        <Border
                                            Padding="12"
                                            BorderBrush="{ThemeResource AppDividerBrush}"
                                            BorderThickness="0,0,0,1">
                                            <Grid ColumnSpacing="{StaticResource AppSpacingSm}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Spacing="{StaticResource AppSpacingXs}">
                                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind DisplayName, Mode=OneTime}" TextWrapping="Wrap" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource AppSecondaryTextBrush}"
                                                        Text="{x:Bind Capabilities, Mode=OneTime}"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Button
                                                    x:Uid="InstalledModelInfoButton"
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.AutomationId="{x:Bind DetailsAutomationId, Mode=OneTime}"
                                                    Click="InstalledModelInfoButton_Click"
                                                    Style="{StaticResource AppInfoButtonStyle}"
                                                    Tag="{x:Bind PackageKey, Mode=OneTime}">
                                                    <FontIcon
                                                        AutomationProperties.AccessibilityView="Raw"
                                                        Glyph="{StaticResource AppInfoIconGlyph}" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Grid
                x:Name="ModelOperationStatusPanel"
                Margin="0,9,0,0"
                Visibility="{x:Bind local:LocalAnalysisSettingsPage.ModelOperationStatusVisibility(ViewModel.IsWorking, ViewModel.HasStatusMessage), Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid
                    x:Name="ModelOperationGrid"
                    ColumnSpacing="{StaticResource AppSpacingMd}"
                    Visibility="{x:Bind local:SettingsPage.BoolToVisibility(ViewModel.IsWorking), Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar
                        x:Name="ModelOperationProgressBar"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="ModelOperationProgressBar"
                        IsIndeterminate="{x:Bind ViewModel.IsModelProgressIndeterminate, Mode=OneWay}"
                        Maximum="100"
                        ShowError="False"
                        Value="{x:Bind ViewModel.ModelProgressPercent, Mode=OneWay}"
                        Visibility="{x:Bind local:SettingsPage.BoolToVisibility(ViewModel.IsWorking), Mode=OneWay}" />
                    <Button
                        x:Name="CancelModelOperationButton"
                        x:Uid="CancelModelOperationButton"
                        Grid.Column="1"
                        AutomationProperties.AutomationId="CancelModelOperationButton"
                        Click="CancelModelOperationButton_Click"
                        IsEnabled="{x:Bind ViewModel.CanCancelModelOperation, Mode=OneWay}"
                        Visibility="{x:Bind local:SettingsPage.BoolToVisibility(ViewModel.CanCancelModelOperation), Mode=OneWay}" />
                </Grid>

                <InfoBar
                    x:Name="ModelManagementStatusInfoBar"
                    x:Uid="ModelManagementStatusInfoBar"
                    Grid.Row="1"
                    AutomationProperties.AutomationId="ModelManagementStatusInfoBar"
                    AutomationProperties.HelpText="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    IsClosable="True"
                    IsOpen="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}"
                    Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    Severity="{x:Bind local:SettingsPage.StatusSeverity(ViewModel.IsStatusError), Mode=OneWay}"
                    Visibility="{x:Bind local:LocalAnalysisSettingsPage.BoolToVisibility(ModelManagementStatusInfoBar.IsOpen), Mode=OneWay}" />
            </Grid>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
